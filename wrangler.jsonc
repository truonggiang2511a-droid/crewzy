{
  // Crewzy trên Cloudflare Workers. Deploy: push lên GitHub (Workers Builds tự chạy `npx wrangler deploy`).
  "name": "crewzy",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/mcp/*"],
    "not_found_handling": "404-page",
    "html_handling": "none"
  },
  // Workers AI: tạo ảnh (flux-2-klein-4b, dự phòng flux-1-schnell) cho công cụ CREWZY_TAO_ANH.
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    { "binding": "KV", "id": "cefc3dfec3b248929a490ff8cd5cc216" }
  ],
  // R2: ảnh/video/âm thanh tải lên, MCP ngoài, video credit (src/lib/media.js). Miễn phí 10GB, không tính băng thông.
  // D1: tài khoản, gói, credit, đơn thanh toán, giao dịch SePay (src/lib/billing.js, migrations/0001_billing.sql).
  "d1_databases": [
    { "binding": "DB", "database_name": "crewzy-db", "database_id": "42d830fe-378c-44f5-8d9f-7f3a42b1ca70", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "crewzy-media" }
  ],
  // Khoá bí mật đặt trong dashboard (Worker → Settings → Variables and Secrets), KHÔNG ghi ở đây:
  // COMPOSIO_API_KEY, ANTHROPIC_API_KEY, SESSION_SECRET, GOOGLE_CLIENT_ID. keep_vars giữ biến đặt trên dashboard khi deploy.
  "keep_vars": true,
  // Hẹn giờ chạy quy trình (src/lib/schedules.js): mỗi 15 phút
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
